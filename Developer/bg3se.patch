@@ -0,0 +1,61 @@
+[CmdletBinding()]
+param()
+$ErrorActionPreference='Stop'
+$root=Split-Path $PSScriptRoot -Parent
+$work=Split-Path (Split-Path $root -Parent) -Parent
+$external=Join-Path $root 'External'
+$download=Join-Path $work 'Downloads\BG3SE-Build'
+New-Item -ItemType Directory -Path $external,$download -Force | Out-Null
+$repos=@(
+ @{Name='Detours';Url='https://github.com/microsoft/Detours';Ref='v4.0.1'},
+ @{Name='glm';Url='https://github.com/g-truc/glm';Ref='1.0.3'},
+ @{Name='imgui';Url='https://github.com/Norbyte/imgui';Ref=''},
+ @{Name='lua';Url='https://github.com/Norbyte/lua-dos';Ref=''},
+ @{Name='optick';Url='https://github.com/Norbyte/optick';Ref=''},
+ @{Name='protobuf';Url='https://github.com/protocolbuffers/protobuf';Ref='v36.1'},
+ @{Name='rapidjson';Url='https://github.com/tencent/rapidjson';Ref='24b5e7a8b27f42fa16b96fc70aade9106cf7102f'},
+ @{Name='tinycrypt';Url='https://github.com/intel/tinycrypt';Ref=''},
+ @{Name='Vulkan';Url='https://github.com/KhronosGroup/Vulkan-Headers';Ref='vulkan-sdk-1.4.357'},
+ @{Name='ZipLib';Url='https://github.com/Norbyte/ZipLib';Ref=''}
+)
+$git=(Get-Command git).Source
+$results=@($repos | ForEach-Object -Parallel {
+ $ErrorActionPreference='Stop'; $repo=$_; $dest=Join-Path $using:external $repo.Name
+ try {
+  if(-not(Test-Path -LiteralPath $dest)){
+   $args=@('clone','--depth','1')
+   if($repo.Ref -and $repo.Ref.Length-ne 40){$args+=@('--branch',$repo.Ref)}
+   & $using:git @args $repo.Url $dest 2>&1 | Out-Null
+   if($LASTEXITCODE-ne 0){throw "Clone failed: $($repo.Name)"}
+   if($repo.Ref.Length-eq 40){
+    & $using:git -C $dest fetch --depth 1 origin $repo.Ref 2>&1 | Out-Null
+    if($LASTEXITCODE-ne 0){throw 'Pinned revision fetch failed'}
+    & $using:git -C $dest checkout --detach $repo.Ref 2>&1 | Out-Null
+    if($LASTEXITCODE-ne 0){throw 'Pinned revision checkout failed'}
+   }
+  }
+  $commit=& $using:git -C $dest rev-parse HEAD
+  if($LASTEXITCODE-ne 0){throw 'Cannot identify repository revision'}
+  [pscustomobject]@{Name=$repo.Name;Source=$repo.Url;Ref=$repo.Ref;Commit=$commit;Path=$dest;Status='FETCHED'}
+ }catch{[pscustomobject]@{Name=$repo.Name;Status='FAILED';Error=$_.Exception.Message}}
+} -ThrottleLimit 4)
+$archives=@(
+ @{Name='curl';Url='https://bg3se-updates.norbyte.dev/Stuff/curl.zip';Target=$external;Strip=0},
+ @{Name='NoesisGUI';Url='https://bg3se-updates.norbyte.dev/Stuff/NoesisGUI-NativeSDK-win-3.1.7-Indie.zip';Target=$external;Strip=0},
+ @{Name='protoc';Url='https://github.com/protocolbuffers/protobuf/releases/download/v36.1/protoc-36.1-win64.zip';Target=(Join-Path $external 'protoc');Strip=0},
+ @{Name='SDL';Url='https://github.com/libsdl-org/SDL/releases/download/release-2.30.6/SDL2-devel-2.30.6-VC.zip';Target=(Join-Path $external 'SDL');Strip=1}
+)
+$results+=@($archives | ForEach-Object -Parallel {
+ $ErrorActionPreference='Stop'; $a=$_; $zip=Join-Path $using:download ($a.Name+'.zip')
+ try {
+  if(-not(Test-Path -LiteralPath $zip)){Invoke-WebRequest -Uri $a.Url -OutFile $zip}
+  New-Item -ItemType Directory -Path $a.Target -Force | Out-Null
+  # Known author build dependencies only; tar performs no code execution.
+  & tar -xf $zip -C $a.Target --strip-components $a.Strip
+  if($LASTEXITCODE-ne 0){throw 'Archive extraction failed'}
+  [pscustomobject]@{Name=$a.Name;Source=$a.Url;Path=$a.Target;Archive=$zip;SHA256=(Get-FileHash -LiteralPath $zip).Hash;Status='FETCHED'}
+ }catch{[pscustomobject]@{Name=$a.Name;Status='FAILED';Error=$_.Exception.Message}}
+} -ThrottleLimit 4)
+$results | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $work 'Logs\BG3SE-BuildDependencies.json')
+$results | Select-Object Name,Status,Commit,Error | Format-Table -AutoSize
+if($results.Status-contains 'FAILED'){throw 'One or more dependencies failed; see BG3SE-BuildDependencies.json'}
diff --git a/MicrosoftCompatibility/Generate-CMake.py b/MicrosoftCompatibility/Generate-CMake.py
