diff --git a/MicrosoftCompatibility/BootstrapTrace.h b/MicrosoftCompatibility/BootstrapTrace.h
new file mode 100644
index 0000000..18532a7
--- /dev/null
+++ b/MicrosoftCompatibility/BootstrapTrace.h
@@ -0,0 +1,26 @@
+#pragma once
+#include <windows.h>
+#include <cwchar>
+
+namespace bg3se::microsoft {
+
+// Early diagnostics must work before game symbols, config, or Lua exist.
+// This local investigation writes only within its existing workspace.
+inline void BootstrapTrace(wchar_t const* message, DWORD detail = 0)
+{
+    wchar_t path[32768]{};
+    auto length = GetEnvironmentVariableW(L"USERPROFILE", path, 32000);
+    if (!length || length >= 32000) return;
+    swprintf_s(path + length, std::size(path) - length,
+        L"\\BG3-Modding-Work\\Logs\\ScriptExtender\\Bootstrap-%lu.log", GetCurrentProcessId());
+    auto file = CreateFileW(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE,
+        nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return;
+    wchar_t line[2048]{};
+    auto count = swprintf_s(line, L"%llu %ls (%lu)\r\n", GetTickCount64(), message, detail);
+    DWORD written{};
+    if (count > 0) WriteFile(file, line, static_cast<DWORD>(count * sizeof(wchar_t)), &written, nullptr);
+    CloseHandle(file);
+}
+
+}
