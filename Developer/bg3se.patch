--- /dev/null
+++ b/MicrosoftCompatibility/Build-Microsoft.ps1
@@ -0,0 +1,52 @@
+[CmdletBinding()]
+param([int]$Jobs=1,[switch]$ConfigureOnly)
+$ErrorActionPreference='Stop'
+$root=Split-Path $PSScriptRoot -Parent
+$work=Split-Path (Split-Path $root -Parent) -Parent
+$portable=Join-Path $work 'Tools\PortableMSVC'
+$compiler=Get-ChildItem -LiteralPath (Join-Path $portable 'VC\Tools\MSVC') -Directory | Sort-Object Name -Descending | Select-Object -First 1
+$sdk=Get-ChildItem -LiteralPath (Join-Path $portable 'Windows Kits\10\Include') -Directory | Sort-Object Name -Descending | Select-Object -First 1
+if(-not $compiler -or -not $sdk){throw 'Portable MSVC/SDK extraction is incomplete.'}
+$vc=$compiler.FullName;$kit=Join-Path $portable 'Windows Kits\10';$sdkVersion=$sdk.Name
+$python='C:\Python3\python.exe'
+$cmake=Join-Path $work 'Tools\CMake\bin\cmake.exe'
+$ninja=Join-Path $work 'Tools\ninja\ninja.exe'
+$env:PATH="$vc\bin\Hostx64\x64;$kit\bin\$sdkVersion\x64;$(Split-Path $python);$(Split-Path $ninja);$env:PATH"
+$env:INCLUDE="$vc\include;$kit\Include\$sdkVersion\ucrt;$kit\Include\$sdkVersion\shared;$kit\Include\$sdkVersion\um;$kit\Include\$sdkVersion\winrt"
+$env:LIB="$vc\lib\x64;$kit\Lib\$sdkVersion\ucrt\x64;$kit\Lib\$sdkVersion\um\x64"
+$env:VCToolsInstallDir="$vc\";$env:VCToolsVersion=$compiler.Name
+$env:DETOURS_TARGET_PROCESSOR='X64'
+$env:VSCMD_ARG_TGT_ARCH='x64';$env:VSCMD_ARG_HOST_ARCH='x64'
+Push-Location (Join-Path $root 'External\Detours\src')
+try { & nmake /NOLOGO; if($LASTEXITCODE-ne 0){throw 'Detours build failed'} } finally {Pop-Location}
+Push-Location (Join-Path $root 'BG3Extender')
+try {
+ & $python make_enumerations.py; if($LASTEXITCODE-ne 0){throw 'Enumeration generation failed'}
+ & $python make_property_map.py; if($LASTEXITCODE-ne 0){throw 'Property-map generation failed'}
+ foreach($proto in @('Osiris\Debugger\osidebug.proto','Lua\Debugger\LuaDebug.proto','Extender\Shared\ExtenderProtocol.proto')){
+  $directory=Split-Path $proto
+  $stem=[IO.Path]::GetFileNameWithoutExtension($proto)
+  $generated=@((Join-Path $directory ($stem+'.pb.h')),(Join-Path $directory ($stem+'.pb.cc')))
+  $inputTime=(Get-Item -LiteralPath $proto).LastWriteTimeUtc
+  $compilerTime=(Get-Item -LiteralPath "$root\External\protoc\bin\protoc.exe").LastWriteTimeUtc
+  if(@($generated|Where-Object {!(Test-Path -LiteralPath $_) -or (Get-Item -LiteralPath $_).LastWriteTimeUtc-lt $inputTime -or (Get-Item -LiteralPath $_).LastWriteTimeUtc-lt $compilerTime}).Count-eq 0){continue}
+  & "$root\External\protoc\bin\protoc.exe" "--proto_path=$directory" "--cpp_out=$directory" $proto
+  if($LASTEXITCODE-ne 0){throw "Protobuf generation failed: $proto"}
+ }
+} finally {Pop-Location}
+& (Join-Path $PSScriptRoot 'Build-MicrosoftMappings.ps1') | Out-Null
