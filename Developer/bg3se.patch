index 0000000..eb6de84
--- /dev/null
+++ b/MicrosoftCompatibility/Generate-CMake.py
@@ -0,0 +1,111 @@
+"""Portable MSVC build: derive source lists/definitions from upstream projects.
+
+No deployment, game launch, updater download, or system configuration occurs.
+"""
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+root = Path(__file__).resolve().parent.parent
+ns = {"m": "http://schemas.microsoft.com/developer/msbuild/2003"}
+lines = [
+    "cmake_minimum_required(VERSION 3.25)",
+    "cmake_policy(SET CMP0091 NEW)",
+    "project(BG3SEMicrosoft LANGUAGES C CXX RC)",
+    'set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded")',
+    'add_compile_definitions(BG3SE_MICROSOFT_7445165 _ITERATOR_DEBUG_LEVEL=0)',
+    'add_compile_options("$<$<COMPILE_LANGUAGE:CXX>:/std:c++latest>" /Zi /FS)',
+    'set(protobuf_BUILD_TESTS OFF CACHE BOOL "" FORCE)',
+    'set(protobuf_BUILD_PROTOC_BINARIES OFF CACHE BOOL "" FORCE)',
+    'set(protobuf_BUILD_LIBPROTOC OFF CACHE BOOL "" FORCE)',
+    'set(protobuf_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)',
+    'set(protobuf_MSVC_STATIC_RUNTIME ON CACHE BOOL "" FORCE)',
+    'set(ABSL_PROPAGATE_CXX_STD ON CACHE BOOL "" FORCE)',
+    f'add_subdirectory("{root.as_posix()}/External/protobuf" protobuf)',
+]
+
+def quote(path):
+    return '"' + str(path).replace('\\', '/') + '"'
+
+def expand(text, folder):
+    return text.replace('$(SolutionDir)', root.as_posix() + '/').replace('$(ProjectDir)', folder.as_posix() + '/').replace('\\', '/')
+
+for name in ('CoreLib', 'LuaLib', 'imgui', 'Optick', 'TinyCrypt', 'ResourceBundler', 'BG3Extender'):
+    folder = root / name
+    doc = ET.parse(folder / (name + '.vcxproj'))
+    config = 'Game Release|x64' if name == 'BG3Extender' else 'Release|x64'
+    groups = [g for g in doc.findall('m:ItemDefinitionGroup', ns) if f"'{config}'" in g.get('Condition', '')]
+    assert len(groups) == 1, (name, len(groups))
+    group = groups[0]
+    compile = group.find('m:ClCompile', ns)
+    sources = []
+    explicit_cpp_sources = []
+    no_pch = []
+    big_objects = []
+    for node in doc.findall('m:ItemGroup/m:ClCompile', ns):
+        source = node.get('Include')
+        if not source:
+            continue
+        excluded = any(x.text == 'true' and (not x.get('Condition') or f"'{config}'" in x.get('Condition')) for x in node.findall('m:ExcludedFromBuild', ns))
+        if not excluded:
+            path = (folder / source.replace('\\', '/')).resolve()
+            sources.append(path)
+            # MSBuild ClCompile includes are compilation units even when named
+            # .inl (StatsObject.inl). CMake otherwise treats them as headers.
+            if path.suffix.lower() not in ('.c', '.cc', '.cpp', '.cxx', '.c++'):
+                explicit_cpp_sources.append(path)
+            if any(x.text == 'NotUsing' and (not x.get('Condition') or f"'{config}'" in x.get('Condition')) for x in node.findall('m:PrecompiledHeader', ns)):
+                no_pch.append(path)
+            # The 2026 compiler also needs the upstream Debug big-object choice
+            # for these large template units in the optimized portable build.
+            if any('/bigobj' in (x.text or '') for x in node.findall('m:AdditionalOptions', ns)):
+                big_objects.append(path)
+    kind = 'SHARED' if name == 'BG3Extender' else 'STATIC'
+    command = f'add_library({name} {kind}' if name != 'ResourceBundler' else 'add_executable(ResourceBundler'
+    lines += [command] + [quote(p) for p in sources] + [')']
+    if explicit_cpp_sources:
+        lines.append('set_source_files_properties(' + ' '.join(map(quote, explicit_cpp_sources)) + ' PROPERTIES LANGUAGE CXX)')
+    if big_objects:
+        lines.append('set_source_files_properties(' + ' '.join(map(quote, big_objects)) + ' PROPERTIES COMPILE_OPTIONS /bigobj)')
+    lines.append(f'target_include_directories({name} PRIVATE {quote(folder)} {quote(root)})')
+    includes = compile.findtext('m:AdditionalIncludeDirectories', '', ns)
+    for item in includes.split(';'):
+        if item and not item.startswith('%('):
+            lines.append(f'target_include_directories({name} PRIVATE {quote(expand(item, folder))})')
+    defines = compile.findtext('m:PreprocessorDefinitions', '', ns)
+    for define in defines.split(';'):
+        if define and not define.startswith('%('):
+            lines.append(f'target_compile_definitions({name} PRIVATE {define})')
+    # All upstream projects use Unicode Windows APIs.
+    lines.append(f'target_compile_definitions({name} PRIVATE UNICODE _UNICODE)')
+    warnings = compile.findtext('m:DisableSpecificWarnings', '', ns)
+    for warning in warnings.split(';'):
+        if warning.isdecimal():
+            lines.append(f'target_compile_options({name} PRIVATE /wd{warning})')
+    if compile.findtext('m:RuntimeTypeInfo', '', ns) == 'false':
+        lines.append(f'target_compile_options({name} PRIVATE /GR-)')
+    if compile.findtext('m:FloatingPointModel', '', ns) == 'Fast':
+        lines.append(f'target_compile_options({name} PRIVATE /fp:fast)')
+    if compile.findtext('m:CompileAs', '', ns) == 'CompileAsCpp':
+        lines.append('set_source_files_properties(' + ' '.join(map(quote, sources)) + ' PROPERTIES LANGUAGE CXX)')
+    if compile.findtext('m:PrecompiledHeader', '', ns) == 'Use':
+        header = compile.findtext('m:PrecompiledHeaderFile', 'stdafx.h', ns)
+        lines.append(f'target_precompile_headers({name} PRIVATE {quote(folder / header)})')
+        if no_pch:
+            lines.append('set_source_files_properties(' + ' '.join(map(quote, no_pch)) + ' PROPERTIES SKIP_PRECOMPILE_HEADERS ON)')
+
+lines += [
+    f'target_sources(BG3Extender PRIVATE "{root.as_posix()}/BG3Extender/BG3Extender.rc")',
+    f'set_source_files_properties("{root.as_posix()}/BG3Extender/BG3Extender.rc" PROPERTIES OBJECT_DEPENDS "{root.as_posix()}/BG3Extender/GameHooks/BinaryMappingsMicrosoft7445165.xml;{root.as_posix()}/BG3Extender/Lua.bundle")',
