+// Known unused gaps are optional, but requested functionality is not.
+static_assert(IsOptionalMapping("App::UpdatePaths", false, false));
+static_assert(!IsOptionalMapping("App::UpdatePaths", true, false));
+static_assert(IsOptionalMapping("ui::DataContextProvider::ExecuteCommandQueues", false, false));
+static_assert(IsOptionalMapping("ui::DataContextProvider::ExecuteCommandQueues", true, false));
+
+// A critical declaration always wins, including for an allowlisted name.
+static_assert(!IsOptionalMapping("App::UpdatePaths", false, true));
+static_assert(!IsOptionalMapping("ui::DataContextProvider::ExecuteCommandQueues", false, true));
+
+// New failures, near matches and allocator/save checks must keep failing.
+static_assert(!IsOptionalMapping("App::UpdatePaths2", false, false));
+static_assert(!IsOptionalMapping("App::UpdatePaths ", false, false));
+static_assert(!IsOptionalMapping("App::Ctor", false, false));
+static_assert(!IsOptionalMapping("MicrosoftAllocatorFreeContract", false, true));
+static_assert(!IsOptionalMapping("MicrosoftPC::SkipConsoleSaveClassification", false, true));
+static_assert(!IsOptionalMapping("", false, false));
