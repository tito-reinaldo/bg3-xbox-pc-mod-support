diff --git a/MicrosoftCompatibility/BuildIdentity.h b/MicrosoftCompatibility/BuildIdentity.h
new file mode 100644
index 0000000..467f2f4
--- /dev/null
+++ b/MicrosoftCompatibility/BuildIdentity.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <windows.h>
+#include <appmodel.h>
+#include <cwchar>
+#include <iterator>
+
+namespace bg3se::microsoft {
+
+// This experimental binary accepts only the locally audited GDK package.
+// The truncated fixed resource version alone is not an engine build identity.
+inline bool IsBuild7445165(HMODULE module, void* versionResource)
+{
+    if (module != GetModuleHandleW(L"bg3.exe")) return false;
+    wchar_t package[PACKAGE_FULL_NAME_MAX_LENGTH + 1]{};
+    UINT32 length = static_cast<UINT32>(std::size(package));
+    if (GetCurrentPackageFullName(&length, package) != ERROR_SUCCESS
+        || wcscmp(package, L"LarianStudiosGamesLtd.baldurssgate3_1.8.907.0_x64__551z37b1dechw") != 0) {
+        return false;
+    }
+    wchar_t* specialBuild{ nullptr };
+    UINT chars{ 0 };
+    if (!VerQueryValueW(versionResource, L"\\StringFileInfo\\040904b0\\SpecialBuild",
+        reinterpret_cast<void**>(&specialBuild), &chars)
+        || specialBuild == nullptr || chars != 8 || wcscmp(specialBuild, L"7445165") != 0) {
+        return false;
+    }
+    auto dos = reinterpret_cast<IMAGE_DOS_HEADER const*>(module);
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0 || dos->e_lfanew > 4096) return false;
+    auto pe = reinterpret_cast<IMAGE_NT_HEADERS64 const*>(reinterpret_cast<char const*>(module) + dos->e_lfanew);
+    return pe->Signature == IMAGE_NT_SIGNATURE
+        && pe->FileHeader.Machine == IMAGE_FILE_MACHINE_AMD64
+        && pe->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC;
+}
+
+}
diff --git a/MicrosoftCompatibility/Fetch-Dependencies.ps1 b/MicrosoftCompatibility/Fetch-Dependencies.ps1
