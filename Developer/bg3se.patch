@@ -0,0 +1,16 @@
+#pragma once
+#include <string_view>
+
+namespace bg3se::microsoft {
+
+// Exact-build compatibility policy, not a general mapping-error suppression.
+// UpdatePaths is used only by CustomProfile; the command-queue hook has no
+// registered callback consumer in this revision. Missing pointers remain null.
+constexpr bool IsOptionalMapping(std::string_view name, bool customProfileRequested, bool critical)
+{
+    if (critical) return false;
+    return (name == "App::UpdatePaths" && !customProfileRequested)
+        || name == "ui::DataContextProvider::ExecuteCommandQueues";
+}
+
+}
